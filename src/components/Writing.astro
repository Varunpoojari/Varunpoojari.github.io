---
/**
 * Dev.to articles. Rendered at build time; Live.astro refreshes the list in
 * the browser so a new article appears without a rebuild.
 */
import type { Article } from '../lib/live';
import { devtoUser } from '../data/profile';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-IE', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section class="section" id="writing" aria-labelledby="writing-title">
  <div class="section-head">
    <h2 id="writing-title">Writing</h2>
    <p>Notes from building and measuring AI security tooling, published on Dev.to.</p>
  </div>

  <ol class="articles" data-articles>
    {
      articles.map((a) => (
        <li>
          <a class="article" href={a.url} target="_blank" rel="noopener">
            <span class="title">{a.title}</span>
            <span class="desc">{a.description}</span>
            <span class="meta">
              <time datetime={a.publishedAt}>{fmt.format(new Date(a.publishedAt))}</time>, {a.readingTime} min read
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="more">
    <a href={`https://dev.to/${devtoUser}`} target="_blank" rel="noopener">All articles on Dev.to</a>
  </p>
</section>

<style is:global>
  /*
   * Case-file cards. Markup stays li > a.article > .title/.desc/.meta so the
   * client-side refresh in Live.astro keeps working; the file number comes
   * from a CSS counter, and the meta line is pulled to the top with `order`.
   */
  #writing .articles {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 62rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    counter-reset: file;
  }
  #writing .articles li {
    margin: 0;
    counter-increment: file;
    display: flex;
  }
  #writing .article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    padding: 1.1rem 1.15rem 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--ink);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
  }
  /* Evidence-tag file number, top-left of each card. */
  #writing .article::before {
    content: 'No. ' counter(file, decimal-leading-zero);
    align-self: flex-start;
    background: var(--tag);
    color: var(--tag-ink);
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
  }
  #writing .meta {
    order: -1;
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-xs);
    color: var(--muted);
    text-align: right;
  }
  #writing .title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 106;
    font-size: var(--t-md);
    font-weight: 650;
    line-height: 1.25;
    margin-top: 0.25rem;
    text-wrap: balance;
  }
  #writing .desc {
    color: var(--ink-soft);
    font-size: var(--t-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  #writing .article::after {
    content: 'Read on Dev.to \2192';
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--muted);
    transition: color 140ms ease;
  }
  #writing .article:hover,
  #writing .article:focus-visible {
    transform: translateY(-2px);
    border-color: var(--ink);
    box-shadow: 0 4px 0 var(--tag);
  }
  #writing .article:hover::after {
    color: var(--ink);
  }
  /* Newest piece gets the full row on wide screens. */
  @media (min-width: 52rem) {
    #writing .articles li:first-child {
      grid-column: 1 / -1;
    }
    #writing .articles li:first-child .title {
      font-size: var(--t-lg);
    }
    #writing .articles li:first-child .desc {
      -webkit-line-clamp: 3;
      line-clamp: 3;
      max-width: 44rem;
    }
  }
  #writing .more {
    margin-top: 1.25rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 550;
  }
  @media (prefers-reduced-motion: reduce) {
    #writing .article:hover,
    #writing .article:focus-visible {
      transform: none;
    }
  }
</style>
