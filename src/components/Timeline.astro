---
/**
 * Case history. Each era is an exhibit, lettered in order from the most
 * recent. Eras open with a line drawing of the city, then the role, then the
 * dated events that happened during it.
 */
import { eras } from '../data/profile';
import Skyline from './Skyline.astro';
import PrStatus from './PrStatus.astro';
import type { PrState } from '../lib/live';

interface Props {
  prs: Record<string, PrState>;
}
const { prs } = Astro.props;
const letter = (i: number) => String.fromCharCode(66 + i); // A is the hero tag
// The two most recent eras stay open; older ones fold into a one-line toggle.
const OPEN = 2;
const count = (e: (typeof eras)[number]) => (e.points?.length ?? 0) + (e.entries?.length ?? 0);
---

<section class="section timeline" id="history" aria-labelledby="history-title">
  <div class="section-head">
    <h2 id="history-title">Case history</h2>
    <p>Roles, study and the work that happened during each, most recent first.</p>
  </div>

  <ol class="eras">
    {
      eras.map((era, i) => (
        <li class:list={["era", { folded: i >= OPEN }]} id={era.id} data-era>
          <Skyline city={era.city} />
          <div class="era-head">
            <span class="exhibit" aria-label={`Exhibit ${letter(i)}`}>
              {letter(i)}
            </span>
            <div>
              <h3>{era.title}</h3>
              <p class="org">
                {era.org}, {era.place}
              </p>
              <p class="period">
                <time>{era.period}</time>
              </p>
            </div>
          </div>

          <Fragment set:html={i >= OPEN ? `<details class="era-more" data-era-more><summary><span class="more-open">Open case file</span><span class="more-close">Close case file</span><span class="more-count">${count(era)} item${count(era) === 1 ? '' : 's'}</span></summary>` : ''} />
          <div class="era-body prose">
            {era.summary && <p>{era.summary}</p>}
            {era.points && (
              <ul>
                {era.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>

          {era.entries && (
            <ol class="entries">
              {era.entries.map((e) => (
                <li class="entry">
                  <p class="entry-date">
                    <time>{e.date}</time>
                  </p>
                  <div class="entry-main">
                    <h4>
                      {e.title}
                      {e.pr && (
                        <>
                          {' '}
                          <PrStatus pr={e.pr} states={prs} />
                        </>
                      )}
                    </h4>
                    <p>{e.body}</p>
                    {e.links && (
                      <p class="entry-links">
                        {e.links.map((l) => (
                          <a
                            href={l.href}
                            {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                          >
                            {l.label}
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          )}
          <Fragment set:html={i >= OPEN ? '</details>' : ''} />
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Jumping to a folded era (rail link, search palette or a shared URL) opens it.
  const openFor = (hash: string) => {
    const el = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    const d = el?.querySelector<HTMLDetailsElement>('[data-era-more]');
    if (d) d.open = true;
  };
  openFor(location.hash);
  window.addEventListener('hashchange', () => openFor(location.hash));
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (a) openFor(a.getAttribute('href') || '');
  });
</script>

<style>
  .eras {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .era {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--rule);
    margin: 0;
  }
  .era:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .era.folded {
    padding: 1.75rem 0 1.5rem;
  }
  .era.folded .era-head {
    margin-bottom: 0.75rem;
  }
  .era.folded :global(.skyline) {
    max-height: 3.25rem;
    width: auto;
  }
  .era :global(.era-more > summary) {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 3.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    font-family: var(--display);
    font-variation-settings: 'wdth' 104;
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 120ms ease;
  }
  .era :global(.era-more > summary::-webkit-details-marker) {
    display: none;
  }
  .era :global(.era-more > summary::before) {
    content: '+';
    font-weight: 800;
    width: 1ch;
  }
  .era :global(.era-more[open] > summary::before) {
    content: '\2212';
  }
  .era :global(.era-more > summary:hover) {
    border-color: var(--ink-soft);
  }
  .era :global(.more-count) {
    font-weight: 500;
    color: var(--muted);
  }
  .era :global(.more-close),
  .era :global(.era-more[open] .more-open) {
    display: none;
  }
  .era :global(.era-more[open] .more-close) {
    display: inline;
  }
  .era :global(.era-more[open] > summary) {
    margin-bottom: 1.25rem;
  }

  .era-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-bottom: 1.25rem;
  }
  .exhibit {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
    font-size: var(--t-lg);
    background: var(--tag);
    color: var(--tag-ink);
    clip-path: polygon(0.6rem 0, 100% 0, 100% 100%, 0.6rem 100%, 0 calc(100% - 0.6rem), 0 0.6rem);
  }
  .era-head h3 {
    font-size: var(--t-xl);
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
  }
  .org {
    margin: 0.2rem 0 0;
    font-size: var(--t-lg);
    font-style: italic;
    color: var(--ink-soft);
  }
  .period {
    margin: 0.25rem 0 0;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    max-width: 46rem;
  }
  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding: 1.1rem 0 0.4rem 1.25rem;
    border-left: 2px solid var(--rule);
    margin: 0;
    position: relative;
  }
  .entry::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.45rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink-soft);
  }
  @media (min-width: 46rem) {
    .entry {
      grid-template-columns: 7.5rem 1fr;
      gap: 1.25rem;
    }
  }
  .entry-date {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--muted);
    margin: 0.1rem 0 0;
  }
  .entry h4 {
    font-size: var(--t-lg);
    font-variation-settings: 'wdth' 100;
    font-weight: 650;
    margin-bottom: 0.4rem;
  }
  .entry p {
    max-width: var(--measure);
  }
  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 550;
  }
</style>
