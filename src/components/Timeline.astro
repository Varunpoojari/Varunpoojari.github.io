---
/**
 * Case history. Each era is an exhibit, lettered in order from the most
 * recent. Eras open with a line drawing of the city, then the role, then the
 * dated events that happened during it.
 */
import { eras } from '../data/profile';
import Skyline from './Skyline.astro';
import PrStatus from './PrStatus.astro';
import type { PrState } from '../lib/live';

interface Props {
  prs: Record<string, PrState>;
}
const { prs } = Astro.props;
const letter = (i: number) => String.fromCharCode(66 + i); // A is the hero tag
// The two most recent eras stay open; older ones fold into a one-line toggle.
const OPEN = 2;
const count = (e: (typeof eras)[number]) => (e.points?.length ?? 0) + (e.entries?.length ?? 0);
---

<section class="section timeline" id="history" aria-labelledby="history-title">
  <div class="section-head">
    <h2 id="history-title">Case history</h2>
    <p>Roles, study and the work that happened during each, most recent first.</p>
  </div>

  <div class="view-switch" role="group" aria-label="Case history view">
    <button type="button" aria-pressed="true" data-view="list">File</button>
    <button type="button" aria-pressed="false" data-view="board">Evidence board</button>
  </div>

  <div class="board" data-board hidden>
    <svg class="strings" aria-hidden="true" data-strings></svg>
    <ol class="board-cards">
      {
        eras.map((era, i) => (
          <li class="card" style={`--tilt:${[-1.6, 1.2, -0.8, 1.8, -1.2, 0.9, -1.9][i % 7]}deg`} data-card>
            <a href={`#${era.id}`} data-card-link>
              <span class="pin" aria-hidden="true" data-pin></span>
              <span class="card-top">
                <span class="card-letter">{letter(i)}</span>
                <span class="card-period">{era.period}</span>
              </span>
              <span class="card-title">{era.title}</span>
              <span class="card-org">{era.org}, {era.place}</span>
              {era.entries && (
                <span class="card-notes">
                  {era.entries.slice(0, 3).map((e) => (
                    <span class="note">{e.title}</span>
                  ))}
                  {era.entries.length > 3 && <span class="note more-note">+{era.entries.length - 3} more</span>}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <ol class="eras" data-eras>
    {
      eras.map((era, i) => (
        <li class:list={["era", { folded: i >= OPEN }]} id={era.id} data-era>
          <Skyline city={era.city} />
          <div class="era-head">
            <span class="exhibit" aria-label={`Exhibit ${letter(i)}`}>
              {letter(i)}
            </span>
            <div>
              <h3>{era.title}</h3>
              <p class="org">
                {era.org}, {era.place}
              </p>
              <p class="period">
                <time>{era.period}</time>
              </p>
            </div>
          </div>

          <Fragment set:html={i >= OPEN ? `<details class="era-more" data-era-more><summary><span class="more-open">Open case file</span><span class="more-close">Close case file</span><span class="more-count">${count(era)} item${count(era) === 1 ? '' : 's'}</span></summary>` : ''} />
          <div class="era-body prose">
            {era.summary && <p>{era.summary}</p>}
            {era.points && (
              <ul>
                {era.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>

          {era.entries && (
            <ol class="entries">
              {era.entries.map((e) => (
                <li class="entry">
                  <p class="entry-date">
                    <time>{e.date}</time>
                  </p>
                  <div class="entry-main">
                    <h4>
                      {e.title}
                      {e.pr && (
                        <>
                          {' '}
                          <PrStatus pr={e.pr} states={prs} />
                        </>
                      )}
                    </h4>
                    <p>{e.body}</p>
                    {e.links && (
                      <p class="entry-links">
                        {e.links.map((l) => (
                          <a
                            href={l.href}
                            {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                          >
                            {l.label}
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          )}
          <Fragment set:html={i >= OPEN ? '</details>' : ''} />
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Jumping to a folded era (rail link, search palette or a shared URL) opens it.
  const openFor = (hash: string) => {
    const el = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    const d = el?.querySelector<HTMLDetailsElement>('[data-era-more]');
    if (d) d.open = true;
  };
  // File / evidence-board switch. The board is a second view of the same eras;
  // red string joins the cards in time order.
  const section = document.getElementById('history');
  const board = section?.querySelector<HTMLElement>('[data-board]');
  const listView = section?.querySelector<HTMLElement>('[data-eras]');
  const strings = section?.querySelector<SVGSVGElement>('[data-strings]');
  const buttons = [...(section?.querySelectorAll<HTMLButtonElement>('[data-view]') ?? [])];
  const drawStrings = () => {
    if (!board || !strings || board.hidden) return;
    const box = board.getBoundingClientRect();
    const pins = [...board.querySelectorAll<HTMLElement>('[data-pin]')].map((p) => {
      const r = p.getBoundingClientRect();
      return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
    });
    strings.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    const ns = 'http://www.w3.org/2000/svg';
    strings.replaceChildren(
      ...pins.slice(1).map(([x, y], i) => {
        const [px, py] = pins[i];
        const sag = Math.min(40, Math.hypot(x - px, y - py) * 0.12);
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('d', `M${px} ${py} Q${(px + x) / 2} ${(py + y) / 2 + sag} ${x} ${y}`);
        return path;
      }),
    );
  };
  const setView = (view: string) => {
    if (!board || !listView) return;
    const isBoard = view === 'board';
    board.hidden = !isBoard;
    listView.hidden = isBoard;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    try {
      localStorage.setItem('history-view', view);
    } catch {}
    drawStrings();
  };
  buttons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view || 'list')));
  try {
    if (localStorage.getItem('history-view') === 'board' && !location.hash) setView('board');
  } catch {}
  new ResizeObserver(drawStrings).observe(board ?? document.body);
  // A card, or a rail link to an era, opens the file view at that era.
  document.addEventListener(
    'click',
    (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      const id = a?.getAttribute('href')?.slice(1);
      if (id && board && !board.hidden && listView?.querySelector(`[id="${id}"]`)) setView('list');
    },
    true,
  );
  if (location.hash && board && !board.hidden) setView('list');

  openFor(location.hash);
  window.addEventListener('hashchange', () => openFor(location.hash));
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (a) openFor(a.getAttribute('href') || '');
  });
</script>

<style>
  .eras {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .era {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--rule);
    margin: 0;
  }
  .era:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .view-switch {
    display: inline-flex;
    margin: -0.75rem 0 1.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .view-switch button {
    font: inherit;
    font-family: var(--display);
    font-variation-settings: 'wdth' 104;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--muted);
    background: var(--paper-raised);
    border: 0;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }
  .view-switch button + button {
    border-left: 1px solid var(--rule);
  }
  .view-switch button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* Evidence board: cork, pinned index cards, red string. */
  .board {
    --cork: #c9a97c;
    position: relative;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 4px;
    background-color: var(--cork);
    background-image:
      radial-gradient(rgb(90 60 25 / 0.28) 1px, transparent 1.4px),
      radial-gradient(rgb(255 240 210 / 0.25) 1px, transparent 1.4px);
    background-size: 7px 7px, 11px 11px;
    background-position: 0 0, 3px 5px;
    box-shadow: inset 0 0 0 10px rgb(70 45 20 / 0.55), inset 0 0 40px rgb(60 35 10 / 0.35);
  }
  :global(:root[data-theme='dark']) .board {
    --cork: #6e5434;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .board {
      --cork: #6e5434;
    }
  }
  .strings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .strings :global(path) {
    fill: none;
    stroke: #b3261e;
    stroke-width: 2;
    stroke-linecap: round;
    filter: drop-shadow(0 2px 1px rgb(0 0 0 / 0.3));
  }
  .board-cards {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14.5rem), 1fr));
    gap: 2rem 1.5rem;
  }
  .card {
    position: relative;
    z-index: 2;
    margin: 0;
    transform: rotate(var(--tilt));
    transition: transform 160ms ease;
  }
  .card:hover {
    transform: rotate(0deg) scale(1.03);
    z-index: 3;
  }
  .card a {
    position: relative;
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.35rem 1rem 1rem;
    background: #fbfaf5;
    background-image: repeating-linear-gradient(transparent 0 1.45rem, rgb(80 120 170 / 0.14) 1.45rem calc(1.45rem + 1px));
    background-position: 0 2.6rem;
    color: #1b2229;
    text-decoration: none;
    box-shadow: 0 8px 14px -6px rgb(0 0 0 / 0.45);
  }
  .pin {
    position: absolute;
    top: 0.45rem;
    left: 50%;
    width: 0.85rem;
    height: 0.85rem;
    margin-left: -0.425rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffe27a, var(--tag) 45%, #a77d00);
    box-shadow: 0 3px 3px rgb(0 0 0 / 0.4);
    z-index: 4;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-letter {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: 'wdth' 120;
    background: var(--tag);
    color: var(--tag-ink);
    padding: 0 0.4rem;
  }
  .card-period {
    font-family: var(--display);
    font-size: var(--t-xs);
    color: #5d6b77;
  }
  .card-title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 106;
    font-weight: 700;
    font-size: var(--t-md);
    line-height: 1.2;
    margin-top: 0.2rem;
  }
  .card-org {
    font-style: italic;
    font-size: var(--t-sm);
    color: #3a4a57;
  }
  .card-notes {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.35rem;
    font-family: 'Segoe Print', 'Bradley Hand', 'Comic Neue', cursive;
    font-size: var(--t-xs);
    color: #1f3f78;
  }
  .note::before {
    content: '\2192  ';
  }
  .more-note {
    color: #5d6b77;
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transform: none;
    }
  }

  .era.folded {
    padding: 1.75rem 0 1.5rem;
  }
  .era.folded .era-head {
    margin-bottom: 0.75rem;
  }
  .era.folded :global(.skyline) {
    max-height: 3.25rem;
    width: auto;
  }
  .era :global(.era-more > summary) {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 3.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    font-family: var(--display);
    font-variation-settings: 'wdth' 104;
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 120ms ease;
  }
  .era :global(.era-more > summary::-webkit-details-marker) {
    display: none;
  }
  .era :global(.era-more > summary::before) {
    content: '+';
    font-weight: 800;
    width: 1ch;
  }
  .era :global(.era-more[open] > summary::before) {
    content: '\2212';
  }
  .era :global(.era-more > summary:hover) {
    border-color: var(--ink-soft);
  }
  .era :global(.more-count) {
    font-weight: 500;
    color: var(--muted);
  }
  .era :global(.more-close),
  .era :global(.era-more[open] .more-open) {
    display: none;
  }
  .era :global(.era-more[open] .more-close) {
    display: inline;
  }
  .era :global(.era-more[open] > summary) {
    margin-bottom: 1.25rem;
  }

  .era-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-bottom: 1.25rem;
  }
  .exhibit {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
    font-size: var(--t-lg);
    background: var(--tag);
    color: var(--tag-ink);
    clip-path: polygon(0.6rem 0, 100% 0, 100% 100%, 0.6rem 100%, 0 calc(100% - 0.6rem), 0 0.6rem);
  }
  .era-head h3 {
    font-size: var(--t-xl);
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
  }
  .org {
    margin: 0.2rem 0 0;
    font-size: var(--t-lg);
    font-style: italic;
    color: var(--ink-soft);
  }
  .period {
    margin: 0.25rem 0 0;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    max-width: 46rem;
  }
  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding: 1.1rem 0 0.4rem 1.25rem;
    border-left: 2px solid var(--rule);
    margin: 0;
    position: relative;
  }
  .entry::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.45rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink-soft);
  }
  @media (min-width: 46rem) {
    .entry {
      grid-template-columns: 7.5rem 1fr;
      gap: 1.25rem;
    }
  }
  .entry-date {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--muted);
    margin: 0.1rem 0 0;
  }
  .entry h4 {
    font-size: var(--t-lg);
    font-variation-settings: 'wdth' 100;
    font-weight: 650;
    margin-bottom: 0.4rem;
  }
  .entry p {
    max-width: var(--measure);
  }
  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 550;
  }
</style>
