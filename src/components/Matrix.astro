---
/**
 * Skills, laid out like an ATT&CK matrix: tactics as columns, techniques as
 * cells. Selecting a cell shows the evidence behind it.
 */
import { matrix } from '../data/profile';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="section-head">
    <h2 id="skills-title">Skills matrix</h2>
    <p>Arranged like an ATT&amp;CK matrix. Select a skill to see where it was used.</p>
  </div>

  <div class="matrix-wrap">
  <div class="matrix" data-matrix>
    {
      matrix.map((t) => (
        <div class="tactic" role="group" aria-labelledby={`tactic-${t.id}`}>
          <h3 id={`tactic-${t.id}`}>
            {t.name} <span class="count">{t.skills.length}</span>
          </h3>
          <ul>
            {t.skills.map((s) => (
              <li>
                <button type="button" class="cell" aria-pressed="false" data-evidence={JSON.stringify(s.evidence)} data-skill={s.name}>
                  {s.name}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  </div>

  <div class="evidence" aria-live="polite" data-evidence-panel>
    <p class="evidence-empty">
      <span class="bars" aria-hidden="true"><span style="width:78%"></span><span style="width:92%"></span><span style="width:54%"></span></span>
      Evidence is redacted. Select a skill above to declassify it.
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-matrix]');
  const panel = document.querySelector<HTMLElement>('[data-evidence-panel]');
  if (root && panel) {
    const cells = [...root.querySelectorAll<HTMLButtonElement>('.cell')];
    const empty = panel.innerHTML;
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cell');
      if (!btn) return;
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      cells.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      if (wasOn) {
        panel.innerHTML = empty;
        return;
      }
      btn.setAttribute('aria-pressed', 'true');
      const evidence: string[] = JSON.parse(btn.dataset.evidence || '[]');
      panel.replaceChildren();
      const h = document.createElement('p');
      h.className = 'evidence-title';
      h.textContent = btn.dataset.skill || '';
      const ul = document.createElement('ul');
      evidence.forEach((item, i) => {
        const li = document.createElement('li');
        const s = document.createElement('span');
        s.className = 'declassify';
        s.style.setProperty('--d', `${120 + i * 140}ms`);
        s.textContent = item;
        li.append(s);
        ul.append(li);
      });
      panel.append(h, ul);
    });
  }
</script>

<style>
  .matrix-wrap {
    container-type: inline-size;
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  /* Seven tactics, one row, as soon as the column is wide enough. */
  @container (min-width: 50rem) {
    .matrix {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
    .cell {
      font-size: var(--t-xs);
      padding: 0.4rem 0.45rem;
    }
    .tactic h3 {
      padding: 0.65rem 0.55rem;
    }
  }
  /* Mid widths: four columns so the seven split 4 + 3 rather than 6 + 1. */
  @container (min-width: 36rem) and (max-width: 49.99rem) {
    .matrix {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tactic {
    background: var(--paper);
    padding: 0 0 0.5rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .tactic h3 {
    font-size: var(--t-sm);
    font-variation-settings: 'wdth' 112;
    font-weight: 750;
    padding: 0.7rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .count {
    font-weight: 500;
    opacity: 0.7;
  }
  .tactic ul {
    list-style: none;
    padding: 0.5rem 0.5rem 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .tactic li {
    margin: 0;
  }
  .cell {
    width: 100%;
    text-align: left;
    font: inherit;
    font-family: var(--display);
    font-variation-settings: 'wdth' 96;
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    padding: 0.45rem 0.55rem;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }
  .cell:hover {
    border-color: var(--ink-soft);
  }
  .cell[aria-pressed='true'] {
    background: var(--tag);
    border-color: var(--tag);
    color: var(--tag-ink);
    font-weight: 650;
  }

  .evidence {
    margin-top: 1rem;
    min-height: 5.5rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--tag);
    background: var(--paper-raised);
    max-width: var(--measure);
  }
  .evidence :global(.evidence-empty) {
    color: var(--muted);
    margin: 0;
  }
  .bars {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
  }
  .bars span {
    height: 0.8rem;
    background: var(--ink);
    border-radius: 1px;
  }
  /* Same redaction bar as the hero, cleared item by item. */
  .evidence :global(.declassify) {
    background: linear-gradient(var(--ink), var(--ink)) no-repeat right center / 100% 86%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    animation: declassify 480ms cubic-bezier(0.7, 0, 0.2, 1) var(--d) both;
  }
  @keyframes declassify {
    99% {
      background-size: 0% 86%;
    }
    to {
      background-size: 0% 86%;
      background-image: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .evidence :global(.declassify) {
      animation: none;
      background: none;
    }
  }
  .evidence :global(.evidence-title) {
    font-family: var(--display);
    font-variation-settings: 'wdth' 108;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  .evidence :global(ul) {
    margin: 0;
  }
</style>
