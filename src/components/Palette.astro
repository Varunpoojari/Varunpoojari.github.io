---
/**
 * Command palette (Ctrl K / ⌘K / "/"). Jumps to any section, era or project,
 * opens profiles, copies the email address or switches theme. Built on
 * <dialog>, with a combobox and listbox for screen readers.
 */
import { eras, projects, person, githubUser, contributions } from '../data/profile';

type Item = { label: string; hint: string; href?: string; action?: string; external?: boolean; keys?: string };
const items: Item[] = [
  { label: 'Case history', hint: 'Section', href: '#history' },
  ...eras.map((e) => ({ label: `${e.title}, ${e.org}`, hint: e.period, href: `#${e.id}`, keys: [e.place, ...(e.entries ?? []).map((x) => x.title)].join(' ') })),
  { label: 'Selected work', hint: 'Section', href: '#work' },
  ...projects.map((p) => ({ label: p.name, hint: 'Project on GitHub', href: `https://github.com/${githubUser}/${p.repo}`, external: true, keys: p.stack.join(' ') })),
  ...contributions.map((c) => ({ label: c.title, hint: `${c.repo} #${c.pr.split('#')[1]}`, href: c.href, external: true })),
  { label: 'Open source', hint: 'Section', href: '#open-source' },
  { label: 'Skills matrix', hint: 'Section', href: '#skills' },
  { label: 'Writing', hint: 'Section', href: '#writing' },
  { label: 'Certifications and honours', hint: 'Section', href: '#credentials' },
  { label: 'Places', hint: 'Section', href: '#places' },
  { label: 'Contact', hint: 'Section', href: '#contact' },
  ...person.links.map((l) => ({ label: `Open ${l.label}`, hint: l.handle, href: l.href, external: true })),
  { label: 'Copy email address', hint: person.email, action: 'copy-email' },
  { label: 'Switch colour theme', hint: 'Light or dark', action: 'theme' },
];

// A few shell commands for anyone who types instead of searching. Output is
// built here from the same data as the page, so it never drifts from it.
const pad = (s: string, n: number) => s + ' '.repeat(Math.max(1, n - s.length));
const term: Record<string, string> = {
  help: [
    'available commands:',
    '  whoami          who runs this box',
    '  ls projects     tools on GitHub',
    '  git log         upstream pull requests',
    '  history         case history',
    '  cat contact     how to reach me',
    '  pwd             where I am',
    '  clear           back to search',
  ].join('\n'),
  whoami: `${person.name.toLowerCase().replace(' ', '')}\n${person.role}, ${person.location}\nuid=1000 groups=blue-team,red-team,open-source`,
  'ls projects': projects.map((p) => `drwxr-xr-x  ${pad(p.repo + '/', 26)}${p.stack.slice(0, 2).join(', ')}`).join('\n'),
  'git log': contributions
    .map((c) => {
      const t = c.title.length > 38 ? c.title.slice(0, 37) + '…' : c.title;
      return `${c.fallbackState === 'merged' ? 'merged' : 'review'}  ${pad(c.pr.split('/')[1], 22)}${t}`;
    })
    .join('\n'),
  history: eras.map((e, i) => `${String(i + 1).padStart(4)}  ${pad(e.period, 22)}${e.org}`).join('\n'),
  'cat contact': [`email     ${person.email}`, ...person.links.map((l) => `${pad(l.label.toLowerCase(), 10)}${l.href}`)].join('\n'),
  pwd: '/home/varun/dublin/ireland',
};
term.ls = 'projects/  contact  writing/  case-history/\nhint: try "ls projects"';
term['ls -la'] = term['ls projects'];
term.id = term.whoami.split('\n')[2];
term['cat contact.txt'] = term['cat contact'];
---

<dialog class="palette" aria-label="Search the site" data-palette data-email={person.email}>
  <div class="field">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      placeholder="Jump to a section, project or profile, or type help"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd>Esc</kbd>
  </div>
  <ul id="palette-list" role="listbox" class="list" data-palette-list>
    {
      items.map((it, i) => (
        <li role="option" id={`pal-${i}`} aria-selected="false" data-href={it.href} data-action={it.action} data-external={it.external ? '1' : undefined} data-keys={it.keys}>
          <span class="label">{it.label}</span>
          <span class="hint">{it.hint}</span>
        </li>
      ))
    }
  </ul>
  <pre class="term" hidden data-term aria-live="polite"></pre>
  <p class="empty" hidden data-palette-empty>No matches. Try “PyRIT”, “Dublin”, “email”, or type <code>help</code>.</p>
  <script type="application/json" data-term-data set:html={JSON.stringify(term)} />
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-palette-list]')!;
  const empty = dlg.querySelector<HTMLElement>('[data-palette-empty]')!;
  const options = [...list.querySelectorAll<HTMLLIElement>('[role=option]')];
  let active = 0;

  const shown = () => options.filter((o) => !o.hidden);
  const setActive = (i: number) => {
    const s = shown();
    if (!s.length) return;
    active = (i + s.length) % s.length;
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    const el = s[active];
    el.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', el.id);
    el.scrollIntoView({ block: 'nearest' });
  };
  const termOut = dlg.querySelector<HTMLPreElement>('[data-term]')!;
  const termData: Record<string, string> = JSON.parse(dlg.querySelector('[data-term-data]')?.textContent || '{}');
  const shell = (raw: string) => {
    const cmd = raw.trim().replace(/^\$\s*/, '').replace(/\s+/g, ' ').toLowerCase();
    if (!cmd) return null;
    if (termData[cmd]) return termData[cmd];
    if (/^sudo\b/.test(cmd)) return 'varun is not in the sudoers file. This incident will be reported.';
    if (/^(rm -rf|:\(\)|mkfs|dd if=)/.test(cmd)) return 'nice try. this box is read-only.';
    if (cmd === 'exit' || cmd === 'logout') return '';
    return null;
  };
  const filter = () => {
    const out = shell(input.value);
    termOut.hidden = out === null || out === '';
    if (out) {
      termOut.textContent = `$ ${input.value.trim()}\n${out}`;
      list.hidden = true;
      empty.hidden = true;
      return;
    }
    list.hidden = false;
    const q = input.value.trim().toLowerCase();
    options.forEach((o) => (o.hidden = q !== '' && !`${o.textContent} ${o.dataset.keys ?? ''}`.toLowerCase().includes(q)));
    empty.hidden = shown().length > 0;
    setActive(0);
  };
  const open = () => {
    if (dlg.open) return;
    input.value = '';
    filter();
    dlg.showModal();
    input.focus();
  };
  const run = (o: HTMLLIElement) => {
    dlg.close();
    const { href, action, external } = o.dataset;
    if (action === 'copy-email') navigator.clipboard?.writeText(dlg.dataset.email || '').catch(() => {});
    else if (action === 'theme') document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
    else if (href && external) window.open(href, '_blank', 'noopener');
    else if (href) {
      location.hash = href;
      document.querySelector<HTMLElement>(href)?.setAttribute('tabindex', '-1');
      document.querySelector<HTMLElement>(href)?.focus({ preventScroll: true });
    }
  };

  document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName);
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), setActive(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), setActive(active - 1));
    else if (e.key === 'Enter') {
      e.preventDefault();
      const cmd = input.value.trim().toLowerCase();
      if (cmd === 'clear') {
        input.value = '';
        filter();
        return;
      }
      if (cmd === 'exit' || cmd === 'logout') return dlg.close();
      if (!termOut.hidden) return;
      const o = shown()[active];
      if (o) run(o);
    }
  });
  list.addEventListener('click', (e) => {
    const o = (e.target as HTMLElement).closest<HTMLLIElement>('[role=option]');
    if (o) run(o);
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close(); // click on backdrop
  });
</script>

<style>
  .palette {
    width: min(36rem, calc(100vw - 2rem));
    max-height: min(32rem, 80vh);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.45);
    overflow: hidden;
  }
  .palette[open] {
    display: flex;
    flex-direction: column;
  }
  .palette::backdrop {
    background: rgb(10 15 20 / 0.45);
  }
  .field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }
  input {
    flex: 1;
    font: inherit;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-md);
    color: var(--ink);
    background: transparent;
    border: 0;
    outline: none;
  }
  kbd {
    font-family: var(--display);
    font-size: var(--t-xs);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.35rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
  }
  .list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    margin: 0;
  }
  .list li[aria-selected='true'] {
    background: var(--tag);
    color: var(--tag-ink);
  }
  .list li[aria-selected='true'] .hint {
    color: var(--tag-ink);
  }
  .label {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: var(--t-sm);
  }
  .hint {
    font-size: var(--t-xs);
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term {
    margin: 0;
    padding: 0.9rem 1rem 1.1rem;
    max-height: 22rem;
    overflow: auto;
    background: #0d1318;
    color: #c9f2d6;
    font-family: var(--mono);
    font-size: var(--t-xs);
    line-height: 1.55;
    white-space: pre;
  }
  .term::after {
    content: '\2588';
    animation: caret 1s steps(2, start) infinite;
    color: #6cc296;
  }
  @keyframes caret {
    to { visibility: hidden; }
  }
  .empty {
    padding: 1rem;
    color: var(--muted);
    margin: 0;
  }
</style>
