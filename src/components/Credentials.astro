---
import { certifications, honours } from '../data/profile';
const done = certifications.filter((c) => !c.status);
const pending = certifications.filter((c) => c.status);
---

<section class="section" id="credentials" aria-labelledby="cred-title">
  <div class="section-head">
    <h2 id="cred-title">Certifications and honours</h2>
  </div>

  <div class="cols">
    <div>
      <h3>Certifications</h3>
      <ul class="certs">
        {
          done.map((c) => (
            <li>
              {c.href ? (
                <a href={c.href} target="_blank" rel="noopener">
                  {c.name}
                </a>
              ) : (
                <span class="cert-name">{c.name}</span>
              )}
              {c.issuer && <span class="issuer">{c.issuer}</span>}
              {c.id && <span class="id mono">ID {c.id}</span>}
            </li>
          ))
        }
      </ul>
      <h3 class="studying">Studying for</h3>
      <ul class="certs">
        {
          pending.map((c) => (
            <li>
              <span class="cert-name">{c.name}</span>
              <span class="issuer">{c.issuer}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Honours</h3>
      <ul class="honours">{honours.map((h) => <li>{h}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 2rem 3rem;
  }
  @media (min-width: 58rem) {
    .cols {
      grid-template-columns: 3fr 2fr;
    }
  }
  h3 {
    font-size: var(--t-md);
    font-variation-settings: 'wdth' 110;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .studying {
    margin-top: 1.75rem;
  }
  .certs,
  .honours {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .certs li,
  .honours li {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0;
    margin: 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .certs a,
  .cert-name {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
  }
  .issuer {
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .id {
    font-size: var(--t-xs);
    color: var(--muted);
  }
</style>
