---
/**
 * Hero. The one orchestrated moment on the page: redaction bars over the
 * name and introduction decay away on a half-life schedule (each bar clears
 * after half the remaining time of the one before), a nod to MemHalfLife.
 * The text underneath is always real and readable by assistive tech.
 */
import { person } from '../data/profile';
import PrStatus from './PrStatus.astro';
import type { PrState } from '../lib/live';

interface Props {
  prs: Record<string, PrState>;
}
const { prs } = Astro.props;

// Half-life schedule: delays shrink geometrically, so the reveal accelerates.
const halfLife = (i: number) => Math.round(900 * (1 - Math.pow(0.5, i)) + 120);
// Fingerprint watermark: a whorl of broken elliptical ridges, generated so it
// is original line work. Deterministic, so every build draws the same print.
const ridges = Array.from({ length: 22 }, (_, i) => {
  const rx = 14 + i * 9.5;
  const ry = 20 + i * 12;
  const tilt = -8 + i * 0.6;
  const gap = ((i * 37) % 60) + 20; // degrees left open in each ridge
  const start = ((i * 83) % 360) * (Math.PI / 180);
  const sweep = (360 - gap) * (Math.PI / 180);
  const pt = (a: number) => [260 + rx * Math.cos(a), 300 + ry * Math.sin(a)].map((n) => n.toFixed(1)).join(' ');
  return { d: `M${pt(start)} A${rx} ${ry} 0 ${sweep > Math.PI ? 1 : 0} 1 ${pt(start + sweep)}`, tilt };
});

const nameLetters = (w: string) => [...w];
const introLines = [
  'I test LLM applications for prompt injection, data leakage',
  'and unsafe agent integrations, and contribute detection',
  'content and red-teaming tools to open source.',
];
---

<header class="hero" id="top">
  <svg class="print" viewBox="0 0 520 600" aria-hidden="true">
    {ridges.map((r) => <path d={r.d} transform={`rotate(${r.tilt} 260 300)`} />)}
  </svg>
  <div class="hero-text">
    <p class="status" aria-label="Available for roles, based in Dublin">
      <span class="live-dot" aria-hidden="true"></span>
      <span>Available for roles</span>
      <span class="wide"><span class="sep" aria-hidden="true">·</span> Dublin</span>
      <span class="ctf-badge" data-ctf-badge hidden title="All three flags found">CTF 3/3</span>
      <span class="clock" data-clock hidden><span class="sep" aria-hidden="true">·</span> <time data-clock-time></time> local</span>
    </p>
    <p class="role">{person.role}, Dublin</p>
    <h1 class="name" aria-label={person.name} data-name>
      {person.name.split(' ').map((w, wi) => (
        <span class="redact word" style={`--d:${halfLife(wi)}ms`} aria-hidden="true">
          {nameLetters(w).map((ch) => <span class="ch">{ch}</span>)}
        </span>
      ))}
    </h1>
    <p class="intro">
      {
        introLines.map((line, i) => (
          <span class="redact line" style={`--d:${halfLife(i + 2)}ms`}>
            {line}{' '}
          </span>
        ))
      }
    </p>
    <p class="seeking">{person.seeking}</p>
    <ul class="links" aria-label="Profiles">
      {
        person.links.map((l) => (
          <li>
            <a href={l.href} rel="me noopener" target="_blank">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={`mailto:${person.email}`}>Email</a></li>
    </ul>
  </div>

  <a class="exhibit-tag" href="https://github.com/microsoft/PyRIT/pull/3028" target="_blank" rel="noopener">
    <span class="hole" aria-hidden="true"></span>
    <span class="tag-kicker">
      Exhibit A
      <img
        class="org-logo"
        src="https://github.com/microsoft.png?size=64"
        alt="Microsoft"
        width="22"
        height="22"
        loading="lazy"
        decoding="async"
        data-drop-on-error
      />
    </span>
    <span class="tag-title">Merged into Microsoft PyRIT</span>
    <span class="tag-id mono">microsoft/PyRIT #3028</span>
    <span class="tag-body">A dataset loader for 1,000 ATT&amp;CK-tagged prompts from Meta’s CyberSecEval, with 48 tests.</span>
    <PrStatus pr="microsoft/PyRIT#3028" states={prs} fallback="merged" />
    <span class="stamp" aria-hidden="true"><span>Merged</span><span class="stamp-sub">Verified upstream</span></span>
  </a>
</header>

<script>
  // Drop the org logo if GitHub can't serve it (no inline onerror handler,
  // so the Content Security Policy can forbid inline event handlers).
  document.querySelectorAll<HTMLImageElement>('img[data-drop-on-error]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0) img.remove();
    else img.addEventListener('error', () => img.remove(), { once: true });
  });

  // Live Dublin clock in the status line.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const time = document.querySelector<HTMLElement>('[data-clock-time]');
  if (clock && time) {
    const fmt = new Intl.DateTimeFormat('en-IE', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Europe/Dublin' });
    const tick = () => {
      const now = new Date();
      time.textContent = fmt.format(now);
      time.setAttribute('datetime', now.toISOString());
    };
    tick();
    clock.hidden = false;
    setInterval(tick, 15000);
  }

  // The name answers the cursor: letters near the pointer condense and gain
  // weight, then ease back. Rest positions are measured once (and on resize)
  // so the changing widths never feed back into the effect.
  const name = document.querySelector<HTMLElement>('[data-name]');
  const fine = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (name && fine) {
    const hero = name.closest<HTMLElement>('.hero')!;
    const letters = [...name.querySelectorAll<HTMLElement>('.ch')];
    let rest: { x: number; y: number }[] = [];
    // Letters only ever get narrower, so a line can't overflow. The one risk
    // is the reverse: a narrower name fitting on fewer lines. So the resting
    // line break is locked in before the effect starts.
    const words = [...name.querySelectorAll<HTMLElement>('.word')];
    const measure = () => {
      letters.forEach((l) => (l.style.fontVariationSettings = ''));
      name.classList.remove('stacked');
      const tops = words.map((w) => Math.round(w.getBoundingClientRect().top));
      name.classList.toggle('stacked', new Set(tops).size > 1);
      rest = letters.map((l) => {
        const r = l.getBoundingClientRect();
        return { x: r.left + r.width / 2 + scrollX, y: r.top + r.height / 2 + scrollY };
      });
    };
    let frame = 0;
    let px = 0;
    let py = 0;
    const R = 190;
    const paint = () => {
      frame = 0;
      letters.forEach((l, i) => {
        const d = Math.hypot(px - rest[i].x, py - rest[i].y);
        const k = Math.max(0, 1 - d / R);
        const e = k * k * (3 - 2 * k); // smoothstep
        l.style.fontVariationSettings = `'wdth' ${(125 - 50 * e).toFixed(1)}, 'wght' ${(800 + 100 * e).toFixed(0)}`;
      });
    };
    // Measure after the redaction reveal has finished and fonts are in.
    const ready = () => document.fonts.ready.then(measure);
    setTimeout(ready, 1300);
    addEventListener('resize', () => setTimeout(measure, 150));
    hero.addEventListener('pointermove', (e) => {
      if (!rest.length) return;
      px = e.pageX;
      py = e.pageY;
      if (!frame) frame = requestAnimationFrame(paint);
    });
    hero.addEventListener('pointerleave', () => {
      letters.forEach((l) => (l.style.fontVariationSettings = ''));
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-top: clamp(3rem, 10vw, 7rem);
    align-items: end;
    /* The stamp lands from 2.6x scale; keep that from widening the page on phones. */
    overflow-x: clip;
    overflow-clip-margin: 1.5rem;
  }
  @media (min-width: 72rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
  }

  .role {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .status {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0.25rem 0.7rem 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }
  .live-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--merged);
  }
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--merged);
    animation: live 2s ease-out infinite;
  }
  @keyframes live {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(3); opacity: 0; }
  }
  .sep {
    color: var(--muted);
  }
  .ctf-badge {
    order: 9;
    margin-left: 0.25rem;
    padding: 0 0.4rem;
    background: var(--tag);
    color: var(--tag-ink);
    font-weight: 700;
    border-radius: 2px;
  }
  @media (max-width: 30rem) {
    .status .wide {
      display: none;
    }
  }
  .clock time {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  /* Fingerprint watermark behind the name. */
  .print {
    position: absolute;
    z-index: -1;
    top: clamp(-1rem, 2vw, 2rem);
    left: clamp(-6rem, -4vw, -2rem);
    width: clamp(16rem, 36vw, 30rem);
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.045;
    pointer-events: none;
  }

  .name.stacked {
    flex-direction: column;
    align-items: flex-start;
  }
  .ch {
    display: inline-block;
    transition: font-variation-settings 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .name {
    font-size: var(--t-3xl);
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.92;
    margin-bottom: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
  }

  .intro {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    max-width: 34rem;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }
  .intro .line {
    display: inline;
  }

  .seeking {
    color: var(--muted);
    max-width: 34rem;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 550;
  }
  .links li {
    margin: 0;
  }

  /* Redaction bars: an ink background on each inline fragment that shrinks
     away to the right. box-decoration-break: clone gives every wrapped line
     its own bar, so it works at any width. */
  .redact {
    background: linear-gradient(var(--ink), var(--ink)) no-repeat right center / 100% 82%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    animation: declassify 520ms cubic-bezier(0.7, 0, 0.2, 1) var(--d) both;
  }
  @keyframes declassify {
    99% {
      background-size: 0% 82%;
    }
    to {
      background-size: 0% 82%;
      background-image: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .redact {
      animation: none;
      background: none;
    }
  }

  /* Exhibit tag: an evidence tag with clipped corners and a punched hole. */
  .exhibit-tag {
    position: relative;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    padding: 1.6rem 1.25rem 1.25rem 2.6rem;
    background: var(--tag);
    color: var(--tag-ink);
    text-decoration: none;
    clip-path: polygon(1.4rem 0, 100% 0, 100% 100%, 1.4rem 100%, 0 calc(100% - 1.4rem), 0 1.4rem);
    transform: rotate(-2deg);
    transition: transform 200ms ease;
    max-width: 22rem;
  }
  .exhibit-tag:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  .exhibit-tag:focus-visible {
    outline-color: var(--ink);
  }
  .hole {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: -0.35rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 0.2);
  }
  .tag-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-size: var(--t-xs);
    font-weight: 700;
  }
  /* Microsoft's own GitHub organisation avatar, loaded from GitHub. */
  .org-logo {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 3px;
    background: #fff;
    padding: 2px;
    flex: none;
  }
  .tag-title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-size: var(--t-lg);
    font-weight: 750;
    line-height: 1.1;
  }
  .tag-id {
    font-size: var(--t-xs);
  }
  .tag-body {
    font-size: var(--t-sm);
    line-height: 1.45;
    margin-bottom: 0.4rem;
  }
  .exhibit-tag :global(.pr-status) {
    color: var(--tag-ink);
  }

  /* Rubber stamp: lands once, after the redaction bars have cleared. */
  .stamp {
    position: absolute;
    right: 0.55rem;
    bottom: 0.75rem;
    display: grid;
    justify-items: center;
    padding: 0.3rem 0.6rem 0.25rem;
    border: 3px double #6e150f;
    border-radius: 4px;
    color: #6e150f;
    font-family: var(--display);
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    font-size: var(--t-sm);
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    mix-blend-mode: multiply;
    opacity: 0.82;
    transform: rotate(-14deg);
    pointer-events: none;
    /* Uneven ink, like a real stamp. */
    -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 55%, rgb(0 0 0 / 0.55) 100%);
    mask-image: radial-gradient(circle at 30% 40%, #000 55%, rgb(0 0 0 / 0.55) 100%);
    animation: stamp 420ms cubic-bezier(0.16, 1, 0.3, 1) 1500ms both;
  }
  .stamp-sub {
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin-top: 0.2rem;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-14deg) scale(2.6);
    }
    70% {
      opacity: 0.9;
      transform: rotate(-14deg) scale(0.94);
    }
    to {
      opacity: 0.82;
      transform: rotate(-14deg) scale(1);
    }
  }
  .exhibit-tag {
    animation: thud 260ms ease-out 1760ms both;
  }
  @keyframes thud {
    0% { translate: 0 0; }
    35% { translate: 0 3px; }
    100% { translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot::after {
      animation: none;
    }
    .stamp,
    .exhibit-tag {
      animation: none;
    }
  }
</style>
