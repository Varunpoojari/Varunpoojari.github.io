---
/**
 * Original single-stroke line drawings of the cities each era happened in.
 * Drawn by hand as simple SVG paths; they inherit colour from the text.
 */
interface Props {
  city: 'dublin' | 'pune' | 'bengaluru' | 'texas';
}
const { city } = Astro.props;

const labels = {
  dublin: 'Line drawing of Dublin: the Custom House dome, the Spire, the Ha’penny Bridge and the harp-shaped Samuel Beckett Bridge over the Liffey.',
  pune: 'Line drawing of Pune: the fortified walls, bastions and arched gate of Shaniwar Wada, with the Sahyadri hills behind.',
  bengaluru: 'Line drawing of Bengaluru: the Vidhana Soudha with its central dome and colonnade.',
  texas: 'Line drawing of College Station, Texas: a domed academic building and a water tower on a flat horizon.',
};
---

<svg class="skyline" viewBox="0 0 600 90" role="img" aria-label={labels[city]} preserveAspectRatio="xMinYMax meet">
  {
    city === 'dublin' && (
      <g>
        {/* river */}
        <path d="M0 82 H600" />
        <path d="M20 87 H140 M190 87 H330 M380 87 H560" class="faint" />
        {/* Custom House: colonnade, dome */}
        <path d="M30 78 V58 H150 V78" />
        <path d="M44 78 V62 M58 78 V62 M72 78 V62 M108 78 V62 M122 78 V62 M136 78 V62" class="faint" />
        <path d="M78 58 V46 H102 V58" />
        <path d="M80 46 Q90 30 100 46" />
        <path d="M90 34 V26" />
        {/* Spire */}
        <path d="M215 82 L218 4 L221 82" />
        {/* Ha'penny Bridge */}
        <path d="M250 80 Q300 56 350 80" />
        <path d="M262 74 V80 M276 68.5 V80 M290 65.5 V80 M300 65 V80 M310 65.5 V80 M324 68.5 V80 M338 74 V80" class="faint" />
        {/* Samuel Beckett Bridge: curved mast and cables */}
        <path d="M420 80 H560" />
        <path d="M470 80 Q462 40 484 16" />
        <path d="M484 16 L430 80 M481 22 L445 80 M477 30 L460 80 M484 16 L500 80 M481 22 L520 80 M477 30 L540 80" class="faint" />
      </g>
    )
  }
  {
    city === 'pune' && (
      <g>
        <path d="M0 82 H600" />
        {/* hills */}
        <path d="M0 50 Q60 28 120 46 T250 40 T380 48 T520 34 T600 44" class="faint" />
        {/* fort wall with bastions */}
        <path d="M60 82 V58 H180" />
        <path d="M180 82 V48 Q195 40 210 48 V82" />
        <path d="M210 58 H250" />
        {/* gate: tall arched doorway with tiers */}
        <path d="M250 82 V36 H330 V82" />
        <path d="M270 82 V60 Q290 40 310 60 V82" />
        <path d="M250 44 H330 M262 36 V30 H318 V36" />
        <path d="M330 58 H370" />
        <path d="M370 82 V48 Q385 40 400 48 V82" />
        <path d="M400 58 H540 V82" />
        <path d="M70 58 V54 M90 58 V54 M110 58 V54 M130 58 V54 M150 58 V54 M170 58 V54 M420 58 V54 M440 58 V54 M460 58 V54 M480 58 V54 M500 58 V54 M520 58 V54" class="faint" />
      </g>
    )
  }
  {
    city === 'bengaluru' && (
      <g>
        <path d="M0 82 H600" />
        {/* wings */}
        <path d="M90 82 V56 H230 M370 56 H510 V82" />
        <path d="M104 56 V50 H216 V56 M384 56 V50 H496 V56" class="faint" />
        {/* small domes on wings */}
        <path d="M150 50 Q160 38 170 50 M430 50 Q440 38 450 50" />
        {/* central block and colonnade */}
        <path d="M230 82 V46 H370 V56" />
        <path d="M244 82 V54 M258 82 V54 M272 82 V54 M286 82 V54 M314 82 V54 M328 82 V54 M342 82 V54 M356 82 V54" class="faint" />
        <path d="M236 54 H364" class="faint" />
        {/* drum and dome */}
        <path d="M278 46 V36 H322 V46" />
        <path d="M280 36 Q300 6 320 36" />
        <path d="M300 14 V6" />
        {/* trees */}
        <path d="M40 82 V68 M40 68 Q30 62 40 52 Q50 62 40 68 M560 82 V66 M560 66 Q548 58 560 48 Q572 58 560 66" class="faint" />
      </g>
    )
  }
  {
    city === 'texas' && (
      <g>
        <path d="M0 82 H600" />
        {/* academic building with dome */}
        <path d="M150 82 V50 H310 V82" />
        <path d="M166 82 V58 M182 82 V58 M198 82 V58 M262 82 V58 M278 82 V58 M294 82 V58" class="faint" />
        <path d="M206 50 V38 H254 V50" />
        <path d="M208 38 Q230 8 252 38" />
        <path d="M230 16 V6" />
        {/* water tower */}
        <path d="M430 82 L440 44 M470 82 L460 44 M436 62 H464" />
        <path d="M428 44 H472 V30 Q450 20 428 30 Z" />
        <path d="M450 22 V16" />
        {/* scrub */}
        <path d="M40 82 Q46 74 52 82 M70 82 Q78 72 86 82 M540 82 Q548 74 556 82" class="faint" />
      </g>
    )
  }
</svg>

<style>
  .skyline {
    width: 100%;
    max-width: 30rem;
    height: auto;
    color: var(--ink-soft);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 1rem;
  }
  .skyline :global(.faint) {
    stroke: var(--muted);
    stroke-width: 0.9;
    opacity: 0.7;
  }
</style>
