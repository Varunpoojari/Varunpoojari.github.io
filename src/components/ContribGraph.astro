---
/**
 * GitHub contribution tiles for the last six months, drawn at build time as
 * plain SVG. Columns are weeks (Sunday first), rows are days.
 */
import { githubUser } from '../data/profile';
import type { ContributionDay } from '../lib/live';

interface Props {
  days: ContributionDay[];
  weeks?: number;
}
const { days, weeks: span = 26 } = Astro.props;

// Chunk into Sunday-first weeks, then keep the most recent `span` of them.
const start = days.findIndex((d) => new Date(`${d.date}T00:00:00Z`).getUTCDay() === 0);
const all: ContributionDay[][] = [];
for (let i = Math.max(start, 0); i < days.length; i += 7) all.push(days.slice(i, i + 7));
const weeks = all.slice(-span);

const shown = weeks.flat();
const total = shown.reduce((sum, d) => sum + d.count, 0);
const activeDays = shown.filter((d) => d.count > 0).length;

const cell = 11;
const step = 14;
const left = 30;
const top = 18;
const width = left + weeks.length * step;
const height = top + 7 * step;

const monthFmt = new Intl.DateTimeFormat('en-IE', { month: 'short', timeZone: 'UTC' });
const dateFmt = new Intl.DateTimeFormat('en-IE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const months: { x: number; label: string }[] = [];
weeks.forEach((w, i) => {
  const m = new Date(`${w[0].date}T00:00:00Z`).getUTCMonth();
  const prev = i > 0 ? new Date(`${weeks[i - 1][0].date}T00:00:00Z`).getUTCMonth() : -1;
  if (m !== prev && !(i === 0 && new Date(`${w[0].date}T00:00:00Z`).getUTCDate() > 21)) {
    months.push({ x: left + i * step, label: monthFmt.format(new Date(`${w[0].date}T00:00:00Z`)) });
  }
});
const tip = (d: ContributionDay) =>
  `${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${dateFmt.format(new Date(`${d.date}T00:00:00Z`))}`;
const level = (d: ContributionDay) => Math.min(4, Math.max(0, d.level));
---

<figure class="contrib">
  <figcaption class="contrib-head">
    <span><strong>{total}</strong> contributions on GitHub in the last six months</span>
    <a href={`https://github.com/${githubUser}`} target="_blank" rel="noopener">View profile</a>
  </figcaption>
  <div class="contrib-scroll">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      role="img"
      aria-label={`GitHub contribution graph: ${total} contributions across ${activeDays} days in the last six months.`}
    >
      {months.map((m) => <text class="lbl" x={m.x} y={11}>{m.label}</text>)}
      {['Mon', 'Wed', 'Fri'].map((d, i) => (
        <text class="lbl" x={0} y={top + (1 + i * 2) * step + cell - 2}>{d}</text>
      ))}
      {
        weeks.map((w, wi) =>
          w.map((d) => (
            <rect
              class={`l${level(d)}`}
              x={left + wi * step}
              y={top + new Date(`${d.date}T00:00:00Z`).getUTCDay() * step}
              width={cell}
              height={cell}
              rx="2"
            >
              <title>{tip(d)}</title>
            </rect>
          )),
        )
      }
    </svg>
  </div>
  <div class="legend" aria-hidden="true">
    Less
    {[0, 1, 2, 3, 4].map((l) => <svg width="11" height="11"><rect class={`l${l}`} width="11" height="11" rx="2" /></svg>)}
    More
  </div>
</figure>

<style>
  .contrib {
    margin: 0 0 2.25rem;
    max-width: 40rem;
    padding: 1rem 1.1rem 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .contrib-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }
  .contrib-head strong {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .contrib-head a {
    font-weight: 600;
    color: var(--ink);
  }
  .contrib-scroll {
    overflow-x: auto;
  }
  .contrib-scroll svg {
    display: block;
    width: 100%;
    min-width: 20rem;
    height: auto;
  }
  .lbl {
    font-family: var(--display);
    font-size: 9px;
    fill: var(--muted);
  }
  /* Green ramp built from the site's merged-status green, so it follows the theme. */
  .l0 { fill: var(--rule-soft); }
  .l1 { fill: color-mix(in oklab, var(--merged) 32%, var(--paper-raised)); }
  .l2 { fill: color-mix(in oklab, var(--merged) 56%, var(--paper-raised)); }
  .l3 { fill: color-mix(in oklab, var(--merged) 80%, var(--paper-raised)); }
  .l4 { fill: var(--merged); }
  .contrib rect {
    transition: opacity 120ms ease;
  }
  .contrib-scroll svg:hover rect:not(:hover) {
    opacity: 0.7;
  }
  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-top: 0.5rem;
    font-family: var(--display);
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .legend svg {
    display: inline-block;
  }
</style>
