---
/**
 * Open source ledger: every upstream pull request, with live status.
 */
import { contributions } from '../data/profile';
import PrStatus from './PrStatus.astro';
import type { PrState } from '../lib/live';

interface Props {
  prs: Record<string, PrState>;
}
const { prs } = Astro.props;
const merged = contributions.filter((c) => (prs[c.pr]?.state ?? c.fallbackState) === 'merged').length;
const repos = new Set(contributions.map((c) => c.repo)).size;
---

<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="section-head">
    <h2 id="oss-title">Open source</h2>
    <p>
      <span data-merged-count>{merged}</span> of {contributions.length} pull requests merged across {repos} upstream projects. Status is checked live against GitHub.
    </p>
  </div>

  <table class="ledger">
    <caption class="visually-hidden">Pull requests to other projects</caption>
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Change</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        contributions.map((c) => (
          <tr>
            <td class="repo">
              <span class="mono">{c.repo}</span>
              <a class="num mono" href={c.href} target="_blank" rel="noopener">
                #{c.pr.split('#')[1]}
              </a>
            </td>
            <td>
              <a class="title" href={c.href} target="_blank" rel="noopener">
                {c.title}
              </a>
              <span class="note">{c.note}</span>
            </td>
            <td class="status">
              <PrStatus pr={c.pr} states={prs} fallback={c.fallbackState} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  thead th {
    text-align: left;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: var(--t-xs);
    color: var(--muted);
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  td {
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
  .repo {
    white-space: nowrap;
    color: var(--ink-soft);
  }
  .repo .num {
    margin-left: 0.4rem;
  }
  .title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 104;
    font-weight: 650;
    font-size: var(--t-md);
    display: block;
  }
  .note {
    color: var(--muted);
  }
  .status {
    text-align: right;
    padding-right: 0;
  }

  @media (max-width: 46rem) {
    thead {
      display: none;
    }
    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--rule-soft);
    }
    td {
      border: 0;
      padding: 0;
    }
    .repo {
      grid-column: 1;
      grid-row: 1;
      white-space: normal;
    }
    .status {
      grid-column: 2;
      grid-row: 1;
    }
    td:nth-child(2) {
      grid-column: 1 / -1;
    }
  }
</style>
