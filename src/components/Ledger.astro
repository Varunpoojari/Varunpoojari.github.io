---
/**
 * Open source ledger: every upstream pull request, with live status.
 */
import { contributions } from '../data/profile';
import PrStatus from './PrStatus.astro';
import type { PrState } from '../lib/live';

interface Props {
  prs: Record<string, PrState>;
}
const { prs } = Astro.props;
const merged = contributions.filter((c) => (prs[c.pr]?.state ?? c.fallbackState) === 'merged').length;
const repos = new Set(contributions.map((c) => c.repo)).size;
const inReview = contributions.filter((c) => (prs[c.pr]?.state ?? c.fallbackState) === 'open').length;
const pct = (n: number) => `${((n / contributions.length) * 100).toFixed(2)}%`;
---

<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="section-head">
    <h2 id="oss-title">Open source</h2>
    <p>
      <span data-merged-count>{merged}</span> of {contributions.length} pull requests merged across {repos} upstream projects. Status is checked live against GitHub.
    </p>
  </div>

  <div class="merge-bar" role="img" aria-label={`${merged} merged, ${inReview} in review, of ${contributions.length} pull requests`}>
    <div class="bar" aria-hidden="true">
      <span class="seg merged" style={`width:${pct(merged)}`}></span>
      <span class="seg open" style={`width:${pct(inReview)}`}></span>
    </div>
    <div class="bar-key" aria-hidden="true">
      <span><i class="sw merged"></i>{merged} merged</span>
      <span><i class="sw open"></i>{inReview} in review</span>
    </div>
  </div>

  <table class="ledger">
    <caption class="visually-hidden">Pull requests to other projects</caption>
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Change</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        contributions.map((c) => (
          <tr>
            <td class="repo">
              <span class="mono">{c.repo}</span>
              <a class="num mono" href={c.href} target="_blank" rel="noopener">
                #{c.pr.split('#')[1]}
              </a>
            </td>
            <td>
              <a class="title" href={c.href} target="_blank" rel="noopener">
                {c.title}
              </a>
              <span class="note">{c.note}</span>
            </td>
            <td class="status">
              <PrStatus pr={c.pr} states={prs} fallback={c.fallbackState} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  thead th {
    text-align: left;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: var(--t-xs);
    color: var(--muted);
    padding: 0 1rem 0.6rem 0;
    border-bottom: 2px solid var(--merged);
  }
  td {
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
  .repo {
    white-space: nowrap;
    color: var(--ink-soft);
  }
  .repo .num {
    margin-left: 0.4rem;
    display: inline-block;
    min-width: 24px;
    padding-block: 0.25rem;
  }
  .title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 104;
    font-weight: 650;
    font-size: var(--t-md);
    display: block;
  }
  .note {
    color: var(--muted);
  }
  .status {
    text-align: right;
    padding-right: 0;
  }
  /* Merged pull requests get a filled green mark, like GitHub's merged badge. */
  .status :global(.pr-status[data-state='merged']) {
    background: var(--merged);
    border-color: var(--merged);
    color: var(--paper-raised);
  }
  tr:has(.pr-status[data-state='merged']) .num {
    color: var(--merged);
    font-weight: 600;
  }

  /* Merge ratio: one bar, green for merged and amber for in review. */
  .merge-bar {
    max-width: 40rem;
    margin: -0.75rem 0 2rem;
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.5rem;
    border-radius: 99px;
    overflow: hidden;
    background: var(--rule-soft);
  }
  .seg.merged,
  .sw.merged {
    background: var(--merged);
  }
  .seg.open,
  .sw.open {
    background: var(--open);
  }
  .bar-key {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .sw {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    margin-right: 0.4rem;
    vertical-align: -0.05em;
  }

  @media (max-width: 46rem) {
    thead {
      display: none;
    }
    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--rule-soft);
    }
    td {
      border: 0;
      padding: 0;
    }
    .repo {
      grid-column: 1;
      grid-row: 1;
      white-space: normal;
    }
    .status {
      grid-column: 2;
      grid-row: 1;
    }
    td:nth-child(2) {
      grid-column: 1 / -1;
    }
  }
</style>
