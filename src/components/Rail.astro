---
/**
 * Navigation rail. On wide screens it is a fixed left column with the case
 * history broken out by era (like a timeline index); on narrow screens it is
 * a top bar with a disclosure menu. Scroll position marks the current item.
 */
import { eras } from '../data/profile';

const sections = [
  { id: 'work', label: 'Selected work' },
  { id: 'open-source', label: 'Open source' },
  { id: 'skills', label: 'Skills matrix' },
  { id: 'writing', label: 'Writing' },
  { id: 'credentials', label: 'Certifications' },
  { id: 'places', label: 'Places' },
  { id: 'contact', label: 'Contact' },
];
// "Aug 2021 – 2025" -> "2021–25"; "Sep 2026 – present" -> "2026–"
const years = (p: string) => {
  const y = p.match(/\d{4}/g) ?? [];
  if (/present/.test(p)) return `${y[0]}–`;
  if (y.length < 2 || y[0] === y[1]) return y[0] ?? '';
  return `${y[0]}–${y[1].slice(2)}`;
};
const shortOrg = (o: string) => o.replace('Technologies', '').replace('University', 'Univ.').trim();
---

<div class="rail">
  <div class="bar">
    <a class="mark" href="#top" aria-label="Varun Poojari, back to top">
      <span class="mark-box" aria-hidden="true">VP</span>
      <span class="mark-name">Varun Poojari</span>
    </a>
    <div class="tools">
      <button type="button" class="tool" data-open-palette aria-keyshortcuts="Control+K Meta+K /">
        <span>Search</span><kbd class="kbd" data-kbd>Ctrl K</kbd>
      </button>
      <button type="button" class="tool icon" data-theme-toggle aria-label="Switch colour theme">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path></svg>
      </button>
      <button type="button" class="tool icon menu-btn" aria-expanded="false" aria-controls="rail-nav" data-menu>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>

  <nav id="rail-nav" class="nav" aria-label="Sections">
    <p class="nav-group"><a href="#history" data-spy="history">Case history</a></p>
    <ol class="eras-nav">
      {
        eras.map((e) => (
          <li>
            <a href={`#${e.id}`} data-spy={e.id}>
              <span class="dot" aria-hidden="true" />
              <span class="era-label">{shortOrg(e.org)}</span>
              <span class="era-year">{years(e.period)}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <ul class="sections">
      {
        sections.map((s) => (
          <li>
            <a href={`#${s.id}`} data-spy={s.id}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  // Platform-appropriate shortcut hint.
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K'));

  // Theme toggle: system → explicit opposite → system.
  const root = document.documentElement;
  const sysDark = matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme || (sysDark.matches ? 'dark' : 'light');
  const store = (v: string | null) => {
    try {
      v ? localStorage.setItem('theme', v) : localStorage.removeItem('theme');
    } catch {}
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    const label = () => btn.setAttribute('aria-label', `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`);
    label();
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      store(next);
      label();
    });
  });

  // Mobile menu.
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = document.getElementById('rail-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menuBtn?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('open');
    }
  });

  // Scroll spy: mark the nav link for the section nearest the top.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-spy]').forEach((a) => links.set(a.dataset.spy!, a));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const visible = new Set<string>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target.id) : visible.delete(en.target.id)));
      // Prefer the deepest visible target in document order (eras over "history").
      const active = targets.filter((t) => visible.has(t.id)).pop();
      links.forEach((a) => a.removeAttribute('aria-current'));
      if (active) {
        links.get(active.id)?.setAttribute('aria-current', 'location');
        if (active.closest('#history') && active.id !== 'history') links.get('history')?.setAttribute('aria-current', 'location');
      }
    },
    { rootMargin: '-15% 0px -70% 0px' },
  );
  targets.forEach((t) => io.observe(t));
</script>

<style>
  .rail {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem var(--gutter);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-weight: 700;
  }
  .mark-box {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    clip-path: polygon(0.45rem 0, 100% 0, 100% 100%, 0.45rem 100%, 0 calc(100% - 0.45rem), 0 0.45rem);
  }
  .tools {
    display: flex;
    gap: 0.4rem;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 550;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    min-height: 2.25rem;
  }
  .tool:hover {
    border-color: var(--ink-soft);
  }
  .tool.icon {
    padding: 0.35rem 0.5rem;
  }
  .mark-name {
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    .kbd {
      display: none;
    }
  }
  @media (max-width: 22rem) {
    .mark-name {
      display: none;
    }
  }
  .kbd {
    font-family: var(--display);
    font-size: var(--t-xs);
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.3rem;
  }

  .nav {
    display: none;
    padding: 0.5rem var(--gutter) 1.25rem;
    max-height: calc(100vh - 3.5rem);
    overflow-y: auto;
  }
  .nav.open {
    display: block;
  }
  .nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a[aria-current] {
    color: var(--ink);
    font-weight: 650;
  }
  .nav-group {
    margin: 0.5rem 0 0.4rem;
  }
  .eras-nav,
  .sections {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .eras-nav {
    margin-left: 0.3rem;
    border-left: 1px solid var(--rule);
    padding: 0.15rem 0;
    margin-bottom: 0.9rem;
  }
  .eras-nav li,
  .sections li {
    margin: 0;
  }
  .eras-nav a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.22rem 0 0.22rem 0;
    margin-left: -0.3rem;
    font-size: var(--t-xs);
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--muted);
  }
  .eras-nav a[aria-current] .dot {
    background: var(--tag);
    border-color: var(--ink);
  }
  .era-year {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sections li a {
    display: block;
    padding: 0.28rem 0;
  }

  @media (min-width: 64rem) {
    .rail {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--rail);
      border-bottom: 0;
      border-right: 1px solid var(--rule);
      display: flex;
      flex-direction: column;
      background: var(--paper);
      backdrop-filter: none;
    }
    .bar {
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem 1.25rem 1rem;
      gap: 1.25rem;
    }
    .tools {
      order: 2;
    }
    .tool:first-child {
      flex: 1;
      justify-content: space-between;
    }
    .menu-btn {
      display: none;
    }
    .nav {
      display: block;
      flex: 1;
      max-height: none;
      padding: 0.5rem 1.25rem 2rem;
    }
  }
</style>
