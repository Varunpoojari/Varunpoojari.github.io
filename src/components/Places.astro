---
/**
 * Countries visited. The map is projected at build time with d3-geo, so the
 * page ships plain SVG paths and no mapping library.
 *
 * Hovering, focusing or tapping a visited country (or its legend entry)
 * paints it with that country's flag. Each flag is an SVG pattern sized to
 * the bounding box of the country's largest landmass, so the contiguous US is
 * not stretched to cover Alaska, and `slice` keeps the flag's proportions.
 */
import { geoEqualEarth, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { countries } from '../data/profile';

const visited = new Map(countries.map((c) => [c.code, c]));
const geo = feature(world as any, (world as any).objects.countries) as any;
const features = geo.features.filter((f: any) => f.id !== '010'); // drop Antarctica
const width = 960;
const height = 440;
const projection = geoEqualEarth().fitSize([width, height], { type: 'FeatureCollection', features } as any);
const path = geoPath(projection).digits(1);

/** Bounds of the largest polygon in a feature, in projected pixels. */
function mainBounds(f: any) {
  const g = f.geometry;
  const polys = g.type === 'MultiPolygon' ? g.coordinates.map((c: any) => ({ type: 'Polygon', coordinates: c })) : [g];
  const largest = polys.reduce((a: any, b: any) => (path.area(b) > path.area(a) ? b : a));
  const [[x0, y0], [x1, y1]] = path.bounds(largest);
  return { x: x0, y: y0, w: Math.max(x1 - x0, 1), h: Math.max(y1 - y0, 1) };
}

const shapes = features.map((f: any) => {
  const id = String(f.id);
  return {
    id,
    name: (visited.get(id)?.name ?? f.properties?.name) as string,
    d: path(f) ?? '',
    visited: visited.has(id),
    box: visited.has(id) ? mainBounds(f) : null,
  };
});
const visitedShapes = shapes.filter((s: any) => s.visited);

// Flags drawn at their official aspect ratios. Colours are each flag's
// published values; they are fixed (not theme tokens) because a flag is a flag.
// `fit: 'none'` stretches a flag to the country's box. Used for simple striped
// flags so every band stays visible on small or compact shapes; flags with
// emblems (stars, crosses) keep their proportions with `slice`.
const flags: Record<string, { vb: string; svg: string; fit?: 'none' }> = {
  // India 3:2: saffron, white, green, navy Ashoka Chakra with 24 spokes
  '356': {
    vb: '0 0 900 600',
    svg:
      '<rect width="900" height="200" fill="#FF9933"/><rect y="200" width="900" height="200" fill="#FFFFFF"/><rect y="400" width="900" height="200" fill="#138808"/>' +
      '<g transform="translate(450 300)" stroke="#000080" fill="none"><circle r="80" stroke-width="10"/>' +
      Array.from({ length: 24 }, (_, i) => `<line x2="${(80 * Math.cos((i * Math.PI) / 12)).toFixed(1)}" y2="${(80 * Math.sin((i * Math.PI) / 12)).toFixed(1)}" stroke-width="4"/>`).join('') +
      '<circle r="14" fill="#000080"/></g>',
  },
  // UAE 2:1: red hoist band, green, white, black
  '784': {
    vb: '0 0 1200 600',
    fit: 'none',
    svg: '<rect width="1200" height="200" fill="#00732F"/><rect y="200" width="1200" height="200" fill="#FFFFFF"/><rect y="400" width="1200" height="200" fill="#000000"/><rect width="300" height="600" fill="#EF3340"/>',
  },
  // United Kingdom 2:1: Union Flag with counterchanged saltire
  '826': {
    vb: '0 0 60 30',
    svg:
      '<clipPath id="uk-clip"><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath>' +
      '<rect width="60" height="30" fill="#012169"/><path d="M0 0l60 30m0-30L0 30" stroke="#FFFFFF" stroke-width="6"/>' +
      '<path d="M0 0l60 30m0-30L0 30" clip-path="url(#uk-clip)" stroke="#C8102E" stroke-width="4"/>' +
      '<path d="M30 0v30M0 15h60" stroke="#FFFFFF" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/>',
  },
  // United States 19:10: 13 stripes, canton with 50 stars (as a 6/5 dot grid)
  '840': {
    vb: '0 0 1900 1000',
    svg:
      '<rect width="1900" height="1000" fill="#FFFFFF"/>' +
      Array.from({ length: 7 }, (_, i) => `<rect y="${((i * 2 * 1000) / 13).toFixed(1)}" width="1900" height="${(1000 / 13).toFixed(1)}" fill="#B31942"/>`).join('') +
      '<rect width="760" height="538.5" fill="#0A3161"/>' +
      Array.from({ length: 9 }, (_, r) =>
        Array.from({ length: r % 2 ? 5 : 6 }, (_, c) => `<circle cx="${(r % 2 ? 126.7 : 63.3) + c * 126.7}" cy="${53.8 + r * 53.8}" r="20" fill="#FFFFFF"/>`).join(''),
      ).join(''),
  },
  // Ireland 2:1: green, white, orange
  '372': {
    vb: '0 0 1200 600',
    fit: 'none',
    svg: '<rect width="400" height="600" fill="#169B62"/><rect x="400" width="400" height="600" fill="#FFFFFF"/><rect x="800" width="400" height="600" fill="#FF883E"/>',
  },
};
---

<section class="section" id="places" aria-labelledby="places-title">
  <div class="section-head">
    <h2 id="places-title">Places</h2>
    <p>Countries I have lived in, studied in or visited. Hover over one, or select it in the list, to see its flag.</p>
  </div>

  <figure class="map" data-map>
    <svg viewBox={`0 0 ${width} ${height}`} role="group" aria-labelledby="map-desc">
      <desc id="map-desc">World map with {countries.length} countries highlighted: {countries.map((c) => c.name).join(', ')}.</desc>
      <defs>
        {
          visitedShapes.map((s: any) => (
            <pattern
              id={`flag-${s.id}`}
              patternUnits="userSpaceOnUse"
              x={s.box.x.toFixed(1)}
              y={s.box.y.toFixed(1)}
              width={s.box.w.toFixed(1)}
              height={s.box.h.toFixed(1)}
              viewBox={flags[s.id]?.vb}
              preserveAspectRatio={flags[s.id]?.fit === 'none' ? 'none' : 'xMidYMid slice'}
              set:html={flags[s.id]?.svg ?? ''}
            />
          ))
        }
      </defs>

      <g class="land" aria-hidden="true">
        {shapes.map((s: any) => <path d={s.d} class={s.visited ? 'visited' : undefined} />)}
      </g>

      <g class="flags">
        {
          visitedShapes.map((s: any) => (
            <path d={s.d} class="flag" fill={`url(#flag-${s.id})`} data-country={s.id} tabindex="0" role="img" aria-label={`${s.name}: show flag`}>
              <title>{s.name}</title>
            </path>
          ))
        }
      </g>
    </svg>
    <figcaption>
      <ul class="legend">
        {
          countries.map((c) => (
            <li>
              <button type="button" class="legend-item" data-country={c.code} aria-pressed="false">
                <span class="swatch" aria-hidden="true" style={`background-image:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='${flags[c.code]?.vb}' preserveAspectRatio='xMidYMid slice'>${(flags[c.code]?.svg ?? '').replace('uk-clip', 'uk-clip-s').replace('url(#uk-clip)', 'url(#uk-clip-s)')}</svg>`)}")`} />
                <span class="country">{c.name}</span>
                {c.note && <span class="note">{c.note}</span>}
              </button>
            </li>
          ))
        }
      </ul>
    </figcaption>
  </figure>
</section>

<script>
  // Legend buttons and taps light a country's flag; hover and focus are pure CSS.
  const map = document.querySelector<HTMLElement>('[data-map]');
  if (map) {
    const setLit = (code: string | null) => {
      map.querySelectorAll<SVGPathElement>('.flag').forEach((p) => p.classList.toggle('lit', p.dataset.country === code));
      map.querySelectorAll<HTMLButtonElement>('.legend-item').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.country === code)));
    };
    map.querySelectorAll<HTMLButtonElement>('.legend-item').forEach((b) => {
      b.addEventListener('mouseenter', () => setLit(b.dataset.country!));
      b.addEventListener('mouseleave', () => setLit(null));
      b.addEventListener('click', () => setLit(b.getAttribute('aria-pressed') === 'true' ? null : b.dataset.country!));
    });
    // Touch: a tap on the map toggles that country's flag.
    map.querySelectorAll<SVGPathElement>('.flag').forEach((p) =>
      p.addEventListener('click', () => setLit(p.classList.contains('lit') ? null : p.dataset.country!)),
    );
  }
</script>

<style>
  .map {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .land path {
    fill: var(--land);
    stroke: var(--paper);
    stroke-width: 0.5;
  }
  .land path.visited {
    fill: var(--land-visited);
  }

  /* The flag layer sits over the visited countries, transparent until lit. */
  .flag {
    fill-opacity: 0;
    stroke: var(--paper);
    stroke-width: 0.5;
    cursor: pointer;
    outline: none;
    transition:
      fill-opacity 220ms ease,
      stroke 220ms ease;
  }
  .flag:hover,
  .flag:focus-visible,
  .flag.lit {
    fill-opacity: 1;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .flag:focus-visible {
    stroke: var(--tag);
    stroke-width: 2;
  }

  .legend {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
  .legend li {
    margin: 0;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 0.3rem 0.45rem;
    margin-left: -0.45rem;
    cursor: pointer;
  }
  .legend-item:hover,
  .legend-item[aria-pressed='true'] {
    border-color: var(--rule);
    background: var(--paper-raised);
  }
  .swatch {
    width: 1.35rem;
    height: 0.9rem;
    flex: none;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }
  .note {
    font-weight: 400;
    color: var(--muted);
  }
</style>
